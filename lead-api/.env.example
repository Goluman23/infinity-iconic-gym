# ======== Which platform sends the WhatsApp messages ========
PROVIDER=easysocial          # easysocial (default) or manychat
INTAKE_KEY=                  # any long random string; the intake page / Google Sheet sends it as X-Intake-Key
DRY_RUN=1                    # 1 = log calls, send nothing. Switch to 0 after the first test.

# ======== EasySocial ========
# Settings → General Settings → Authentication → Generate Access Token
ES_ACCESS_TOKEN=
ES_CLIENT_BASE=https://client-api.e-so.in
ES_CHANNEL_VALUE=919953004008                                   # the WhatsApp number leads are created on
ES_CHANNEL_KEY=contact-easysocial-whatsapp-api-support_number   # as shown in your bulk-create docs/cURL
ES_LOOKUP_PATH=/engage/v1/leads
ES_CREATE_PATH=/api/v1/leads/bulk-create
ES_UPDATE_PATH=/engage/v1/leads/{contact}/update                # confirm with EasySocial support (see guide §09)

# Tag name → numeric tag id (Leads → Tags; ids appear in the tag URL / API)
ES_TAG_IDS={"intake_api":0,"wa_optin":0,"src_website_form":0,"src_meta_form":0,"src_google_form":0,"src_walk_in_now":0,"src_phone_call":0,"src_missed_call":0,"src_ig_phone":0,"src_email":0,"src_corporate":0,"src_broadcast_walkin":0,"src_broadcast_camp":0,"src_broadcast_lapsed":0,"intake_member_contact":0,"intake_while_booked":0}

# One "Broadcast → Create API campaign" per first message. Paste the URL/headers/body EasySocial generates
# and replace the sample values with placeholders: {{phone}} {{phone10}} {{phone_plus}} {{name}} {{first_name}}
# {{goal}} {{time}} {{area}} {{source}}. Set "useToken":false if the cURL carries its own key.
ES_CAMPAIGNS={"form":{"url":"","method":"POST","headers":{},"body":{}},"missed_call":{"url":""},"ig_phone":{"url":""},"corporate":{"url":""},"walkin":{"url":""},"camp":{"url":""},"lapsed":{"url":""}}

# Chatbot brain (EasySocial webhook / API nodes call these with ?key=…)
ES_BRAIN_KEY=                # long random string, put in the node URLs
ES_WEBHOOK_VERIFY_TOKEN=     # the verify token you type in EasySocial → Webhooks
ES_WEBHOOK_SECRET=           # the signing secret EasySocial shows for the webhook
FORWARD_WEBHOOK_URL=         # optional: Google Apps Script URL that logs events to a sheet

# Concierge — AI fallback for messages the EasySocial keywords miss (/api/es/concierge)
CONCIERGE_KEY=               # long random string, put in the EasySocial node URL (falls back to ES_BRAIN_KEY)
ANTHROPIC_API_KEY=           # from console.anthropic.com — without it, unmatched messages get the helpful menu reply
CONCIERGE_MODEL=claude-haiku-5-5
CONCIERGE_AI_TIMEOUT_MS=6000
SHEET_LOG_URL=               # Web app URL of apps-script/Code.gs (conversation log + desk alerts + WhatsApp log)
SHEET_LOG_SECRET=            # same value as SECRET in Code.gs

# ======== ManyChat (only if PROVIDER=manychat) ========
MANYCHAT_API_KEY=
MANYCHAT_PHONE_FIELD=whatsapp_phone
FLOW_FIRST_TOUCH_FORM=
FLOW_FIRST_TOUCH_MISSED_CALL=
FLOW_FIRST_TOUCH_IG_PHONE=
FLOW_FIRST_TOUCH_CORPORATE=
FLOW_BROADCAST_WALKIN=
FLOW_BROADCAST_CAMP=
FLOW_BROADCAST_LAPSED=

# ======== Optional ========
BRAND_NAME=Infinity Iconic
TZ_NAME=Asia/Kolkata
QUIET_START_HOUR=21          # broadcasts paused 21:00–09:00 (form / call leads always sent)
QUIET_END_HOUR=9
DUPLICATE_WINDOW_HOURS=24
BULK_MAX=200
BULK_DELAY_MS=1200
ALLOWED_ORIGIN=*             # set to the intake page URL in production
